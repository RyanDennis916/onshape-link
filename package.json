{
  "name": "onshape-link",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "icons": "node scripts/make-tray-icon.js",
    "icon": "node scripts/make-app-icon.js",
    "assets": "node scripts/make-discord-assets.js",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "description": "A simple link to Discord for Onshape users.",
  "author": "Ryan Dennis",
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "discord-api-types": "^0.38.55",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^30.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.ryandennis.onshape-link",
    "productName": "Onshape Link",
    "files": [
      "dist/**/*",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RyanDennis916",
        "repo": "onshape-link"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
